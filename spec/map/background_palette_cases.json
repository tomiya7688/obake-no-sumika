{
  "schema_version": 1,
  "base_room_fixture": "spec/map/room_geometry_cases.json",
  "room_height": 540,
  "base_definition": {
    "gradient": {"top": [8, 10, 20], "bottom": [15, 18, 30], "step": 8},
    "polygons": [{"color": [5, 7, 14], "points": [[0, 0], [50, 0], [0, 50]]}]
  },
  "cases": [
    {"id":"baseline","expected":{"status":"accepted"}},
    {"id":"rgb-lower-and-step-one","set":{"gradient.top":[0,0,0],"gradient.bottom":[255,255,255],"gradient.step":1,"polygons.0.color":[0,0,0]},"expected":{"status":"accepted"}},
    {"id":"rgb-upper-and-step-height","set":{"gradient.top":[255,255,255],"gradient.bottom":[0,0,0],"gradient.step":540,"polygons.0.color":[255,255,255]},"expected":{"status":"accepted"}},
    {"id":"empty-polygons","set":{"polygons":[]},"expected":{"status":"accepted"}},
    {"id":"metadata-preserved","set":{"gradient.note":"unchanged","polygons.0.extra":{"values":["色"]},"metadata":{"values":["保つ"]}},"expected":{"status":"accepted"}},
    {"id":"bad-root","document":[],"expected":{"status":"rejected"}},
    {"id":"missing-gradient","remove":["gradient"],"expected":{"status":"rejected"}},
    {"id":"invalid-gradient","set":{"gradient":null},"expected":{"status":"rejected"}},
    {"id":"missing-top","remove":["gradient.top"],"expected":{"status":"rejected"}},
    {"id":"missing-bottom","remove":["gradient.bottom"],"expected":{"status":"rejected"}},
    {"id":"top-shape","set":{"gradient.top":[0,0]},"expected":{"status":"rejected"}},
    {"id":"bottom-shape","set":{"gradient.bottom":[0,0,0,0]},"expected":{"status":"rejected"}},
    {"id":"top-low","set":{"gradient.top":[-1,0,0]},"expected":{"status":"rejected"}},
    {"id":"top-high","set":{"gradient.top":[0,256,0]},"expected":{"status":"rejected"}},
    {"id":"bottom-low","set":{"gradient.bottom":[0,0,-1]},"expected":{"status":"rejected"}},
    {"id":"bottom-high","set":{"gradient.bottom":[256,0,0]},"expected":{"status":"rejected"}},
    {"id":"top-fraction","set":{"gradient.top":[8.5,10,20]},"expected":{"status":"rejected"}},
    {"id":"bottom-boolean","set":{"gradient.bottom":[15,true,30]},"expected":{"status":"rejected"}},
    {"id":"top-string","set":{"gradient.top":["8",10,20]},"expected":{"status":"rejected"}},
    {"id":"bottom-huge","set":{"gradient.bottom":[100000000000000000000,18,30]},"expected":{"status":"rejected"}},
    {"id":"missing-step","remove":["gradient.step"],"expected":{"status":"rejected"}},
    {"id":"zero-step","set":{"gradient.step":0},"expected":{"status":"rejected"}},
    {"id":"negative-step","set":{"gradient.step":-1},"expected":{"status":"rejected"}},
    {"id":"step-over-height","set":{"gradient.step":541},"expected":{"status":"rejected"}},
    {"id":"fractional-step","set":{"gradient.step":8.5},"expected":{"status":"rejected"}},
    {"id":"boolean-step","set":{"gradient.step":true},"expected":{"status":"rejected"}},
    {"id":"string-step","set":{"gradient.step":"8"},"expected":{"status":"rejected"}},
    {"id":"huge-step","set":{"gradient.step":100000000000000000000},"expected":{"status":"rejected"}},
    {"id":"missing-polygons","remove":["polygons"],"expected":{"status":"rejected"}},
    {"id":"invalid-polygons","set":{"polygons":{}},"expected":{"status":"rejected"}},
    {"id":"invalid-layer","set":{"polygons":[null]},"expected":{"status":"rejected"}},
    {"id":"missing-layer-color","remove":["polygons.0.color"],"expected":{"status":"rejected"}},
    {"id":"layer-color-shape","set":{"polygons.0.color":[0,0]},"expected":{"status":"rejected"}},
    {"id":"layer-color-low","set":{"polygons.0.color":[0,-1,0]},"expected":{"status":"rejected"}},
    {"id":"layer-color-high","set":{"polygons.0.color":[0,0,256]},"expected":{"status":"rejected"}},
    {"id":"layer-color-fraction","set":{"polygons.0.color":[0.5,0,0]},"expected":{"status":"rejected"}},
    {"id":"layer-color-boolean","set":{"polygons.0.color":[true,0,0]},"expected":{"status":"rejected"}},
    {"id":"invalid-second-layer","set":{"polygons":[{"color":[1,2,3],"points":[[0,0],[50,0],[0,50]]},{"color":[1,2,256],"points":[[0,0],[50,0],[0,50]]}]},"expected":{"status":"rejected"}},
    {"id":"valid-after-failure","expected":{"status":"accepted"}}
  ]
}
